                          "name": "H2b",
                          "fill": "$text-primary",
                          "content": "2. Redline priorities",
                          "fontFamily": "Inter",
                          "fontSize": 15,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "w6quqB",
                          "name": "P2",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Work top-down: limitation of liability, indemnities, data protection, termination, then payment terms. Track agreed deviations in the comments so the next reviewer inherits the reasoning.",
                          "lineHeight": 1.55,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
