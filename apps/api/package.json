{
  "name": "@openlaw/api",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./auth": "./src/auth/instance.ts",
    "./pipeline": {
      "types": "./src/pipeline/index.ts",
      "default": "./dist/pipeline/index.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/documentation/api.mjs && tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node ../../scripts/documentation/api.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "node ../../scripts/documentation/api.mjs && vitest run",
    "openapi:emit": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-storage": "^3.1140.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@better-auth/api-key": "1.7.6",
    "@better-auth/cimd": "1.7.6",
    "@better-auth/drizzle-adapter": "~1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@openlaw/db": "workspace:*",
    "@openlaw/shared": "workspace:*",
    "@scalar/fastify-api-reference": "^1.72.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-auth": "1.7.6",
    "docxtemplater": "^3.71.0",
    "fast-myers-diff": "3.2.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg-boss": "^12.34.0",
    "pizzip": "^3.3.0",
    "postal-mime": "^3.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@testcontainers/azurite": "^12.1.0",
    "@testcontainers/minio": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "oauth2-mock-server": "^9.2.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
