{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"]
  },
  // `vitest.config.ts` is typechecked here, the way `apps/web` checks
  // its `vite.config.ts`. `rootDir` lives in `tsconfig.build.json`,
  // which is the only config that emits — set here it would refuse any
  // include outside `src` (TS6059).
  "include": ["src", "vitest.config.ts"]
}
