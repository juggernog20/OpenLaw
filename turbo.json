{
  "$schema": "https://turborepo.com/schema.json",
  // Files outside every package that a task's output still depends on.
  // `styles/` is here because apps/web's entry imports it across the
  // package boundary (`apps/web/src/main.tsx` -> `../../../styles/globals.css`),
  // so a theme-token edit changes the web bundle. Turbo cannot see that
  // from the package's own inputs, and without this line a token edit
  // replays a stale build.
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", "styles/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      // Run assertions on every candidate. Integration tests depend on
      // containers and mutable upstream images outside Turbo's graph.
      "cache": false,
      "env": ["DOC_ENGINE_TEST_IMAGE"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      // Turbo runs tasks in a filtered environment: a variable the task
      // did not declare is simply absent, which for a watch process
      // reads as "Missing required environment variable DATABASE_URL"
      // with the variable plainly exported in the shell. `dev` is never
      // cached, so nothing here can poison a cache key — and the app
      // reads far more of the environment than a list here would keep
      // up with (storage drivers, signing, SMTP, the secret keys).
      "passThroughEnv": ["*"]
    }
  }
}
