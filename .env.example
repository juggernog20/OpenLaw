# OpenLaw environment — copy to .env and fill in.
# The Compose stack (milestone M3) will consume this file; until then the
# API server (apps/api) reads these directly from the process environment.

# --- Required ---

# Postgres connection string (TECH-004). External/managed Postgres is
# equally supported — point this anywhere reachable.
DATABASE_URL=postgres://openlaw:openlaw@localhost:5432/openlaw

# Secret for session-token signing and at-rest encryption of TOTP seeds
# and backup codes (TECH-008). Generate with: openssl rand -base64 32
# Changing it invalidates existing sessions and enrolled 2FA factors.
AUTH_SECRET=

# --- Optional ---

# Public origin of the install, e.g. https://legal.example.com — used in
# emailed links (magic links, invites) and OIDC callback URLs. Defaults
# to http://localhost:3000 for development.
#BASE_URL=

# Outbound email (TECH-011): SMTP relay URL and From address. Unset means
# email-dependent flows (invites, magic links) report email as
# unconfigured instead of sending.
#SMTP_URL=smtp://user:pass@mail.example.com:587
#SMTP_FROM="OpenLaw <openlaw@example.com>"

# API listen address. Defaults: 3000 / 0.0.0.0
#PORT=3000
#HOST=0.0.0.0
