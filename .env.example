# OpenLaw environment — copy to .env and fill in.
# Read by the Compose stack (compose.yml) and, for bare-process
# development, by the API directly (node --env-file .env, or the shell).

# --- Required ---

# Secret for session-token signing and at-rest encryption of TOTP seeds,
# backup codes (TECH-008), and each SSO user's stored OIDC access and
# refresh tokens (#387). Generate with: openssl rand -base64 32
# Changing it invalidates existing sessions and enrolled 2FA factors.
# The stored OIDC tokens are rewritten by the next SSO sign-in.
AUTH_SECRET=

# Key for at-rest encryption of the credentials an Administrator saves
# in Settings (TECH-022): the DocuSign private key, the DocuSign Connect
# secret, the SMTP relay URL, and the SSO client secret. Generate with:
# openssl rand -base64 32 — a different value from AUTH_SECRET, so that
# rotating one does not touch the other.
#
# KEEP IT OUT OF THE DATABASE BACKUP. This key is what makes a stolen
# `pg_dump` useless, so a backup job that captures this file and the
# dump into one archive gives that back. Store it in a password manager
# or a secret manager, and back it up somewhere the database dump is
# not. Losing it costs the four credentials above — paste them again in
# Settings — and nothing else. See docs/DEPLOYMENT.md.
OPENLAW_SECRET_KEY=

# --- Optional ---

# The retiring key while OPENLAW_SECRET_KEY is being rotated. Set it to
# the old key, start the stack once — the boot re-encrypts every stored
# credential under the new key — then remove it. See docs/DEPLOYMENT.md.
#OPENLAW_SECRET_KEY_PREVIOUS=

# Postgres connection string (TECH-004). Under Compose, leave unset to
# use the bundled Postgres container; set it to point at an external or
# managed Postgres instead. Bare-process development needs it set, e.g.
# postgres://openlaw:openlaw@localhost:5432/openlaw
#DATABASE_URL=

# Public origin of the install, e.g. https://legal.example.com — used in
# emailed links (magic links, invites) and OIDC callback URLs, and what
# your reverse proxy must forward to (see docs/DEPLOYMENT.md). Defaults
# to http://localhost:3000 for development.
#BASE_URL=

# Outbound email (TECH-011): SMTP relay URL and From address. Setting
# SMTP_URL pins email to the environment — it always wins over a relay
# saved in the app's setup wizard. Unset, an Administrator can configure
# SMTP in the app instead; with neither, email-dependent flows (invites,
# magic links) report email as unconfigured instead of sending. The dev
# overlay (compose.dev.yml) overrides these to deliver into Mailpit.
#SMTP_URL=smtp://user:pass@mail.example.com:587
#SMTP_FROM="OpenLaw <openlaw@example.com>"

# Where uploaded files are stored (DOC-009, TECH-014). Three drivers:
# `local` writes blobs to a directory (the default — no extra service to
# run), `s3` writes them to an S3-compatible object store, `azure-blob`
# to Azure Blob Storage. The driver that stored a file is recorded with
# it, and reads follow that record across every configured driver
# (DOC-014) — so files written before a change of driver stay readable
# afterwards, for as long as the old driver's variables stay set. A
# named bucket or container is a configured reader even when it is not
# the write driver, and is checked at boot like one.
#STORAGE_DRIVER=local

# The `local` driver's root directory. Under Compose the `openlaw-files`
# named volume is mounted here, so files survive container restarts.
# Bare-process development needs it set to a directory your own user can
# write, e.g. STORAGE_PATH=./.storage — the directory appears on the
# first upload. Under Compose, keep the default: the mount point follows
# this variable, but only the default path is prepared in the image for
# the container's unprivileged user.
#STORAGE_PATH=/var/lib/openlaw/files

# The `s3` driver. It is written to only when STORAGE_DRIVER=s3, but a
# set S3_BUCKET is read from whatever the write driver is — so leave
# these set for as long as any file's reference still says `s3:`, and
# unset them only once nothing points there. The bucket must already
# exist — OpenLaw never creates one. Leave S3_ENDPOINT unset for
# AWS S3 itself; set it to your store's URL for MinIO, Ceph, R2, Spaces,
# and the rest. Region is what requests are signed for; a MinIO-class
# store ignores it, so leave it unset there. Path-style addressing
# (host/bucket/key instead of bucket.host/key) defaults to on whenever
# S3_ENDPOINT is set, because a non-AWS store rarely has the wildcard DNS
# the other form needs — set it explicitly to override. With both key
# variables unset, the AWS credential chain applies, which is how a
# deployment on AWS uses an instance or IRSA role and holds no key at
# all.
#S3_BUCKET=openlaw-files
#S3_ENDPOINT=https://minio.example.com
#S3_REGION=us-east-1
#S3_FORCE_PATH_STYLE=true
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# The `azure-blob` driver. It is written to only when
# STORAGE_DRIVER=azure-blob, but a set AZURE_BLOB_CONTAINER is read
# from whatever the write driver is — so leave these set for as long as
# any file's reference still says `azure-blob:`, and unset them only
# once nothing points there. The container must already exist — OpenLaw
# never creates one. Fabric / OneLake speaks the same API, so this
# driver reaches it too. Leave
# AZURE_BLOB_ENDPOINT unset for Azure itself, which answers at the
# account's own address; set it for anything else (Azurite, OneLake).
# With the key unset, the Azure credential chain applies, which is how a
# deployment on Azure uses a managed identity and holds no key at all.
#AZURE_BLOB_CONTAINER=openlaw-files
#AZURE_BLOB_ACCOUNT=
#AZURE_BLOB_ACCOUNT_KEY=
#AZURE_BLOB_ENDPOINT=

# The largest file one upload may carry, in whole MB. Defaults to 100.
# An upload over the ceiling is refused with a clear message rather than
# stored. Raise it only alongside your reverse proxy's own body limit —
# a proxy that cuts the request off first turns a clear refusal back
# into a mystery.
#MAX_UPLOAD_MB=100

# The doc-engine sidecar (TECH-010) — the container that converts Word
# and PowerPoint files for display, compares two Word files, OCRs
# scanned PDFs, and reads a PDF's text layer. Under Compose, leave this
# unset: the bundled doc-engine service answers at http://doc-engine:8080
# and needs no configuration.
# Set it to point at an engine you run yourself; bare-process development
# needs it set to wherever you started one. The engine is never published
# to the host, so there is no credential to configure.
#DOC_ENGINE_URL=http://doc-engine:8080

# How long one call to the doc engine may take before it is abandoned, in
# milliseconds. Defaults to 300000 (five minutes) — a hundred-page scan
# is genuinely minutes of OCR. A call that runs out is retried by the job
# that made it, so raising this only matters for documents that genuinely
# take longer than the bound.
#DOC_ENGINE_TIMEOUT_MS=300000

# How long one Word compare may take before it is abandoned, in
# milliseconds. Defaults to 600000 (ten minutes). Compare is the slowest
# thing the engine does: it opens both files in LibreOffice and walks
# them paragraph by paragraph, so it has a bound of its own rather than
# sharing the one above.
#DOC_ENGINE_COMPARE_TIMEOUT_MS=600000

# Under Compose only: how much scratch space the doc engine gets. Its
# root filesystem is read-only and /tmp is a RAM-backed tmpfs, so this
# is the ceiling on what one conversion may write — and it is memory,
# not disk. The default clears the 100 MB upload ceiling with room for
# OCR, whose rasterised intermediate files are much larger than the PDF
# that produced them. Raise it if OCR of very long scans fails on space;
# lower it on a small box if you would rather the conversion fail than
# the host run short of memory.
#DOC_ENGINE_TMPFS_SIZE=2g

# Under Compose: the host port the app is published on (the container
# always listens on 3000 internally). Bare process: the listen port.
#PORT=3000

# Bare process only: the listen address. Defaults to 0.0.0.0.
#HOST=0.0.0.0
